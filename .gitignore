__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/

# Virtual Environment
venv/
.venv/
env/
.virtualenvs/

# Environment & Secrets
.env
.env.local
.env.production
.env.pythonanywhere
*.env

# Django
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# LinkedIn Session (sensitive)
linkedin_session/
*.json.bak
state.json
*.session
*.session.json

# Playwright
playwright-report/
test-results/
storage-state.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Docker
*.log
docker-compose.override.yml

# Celery
celerybeat-schedule
celerybeat.pid

# Database Backups
*.sql
*.sql.gz
*.dump

# Logs
logs/
*.log

# PythonAnywhere
pythonanywhere_task.py.log

# Migration backups
*.bak

# Playwright browser data
playwright/
ms-playwright/

# Local settings override
local_settings.py

# AI / Documentation (keep locally, not in repo)
PROJECT_DOCUMENTATION.md
PYTHONANYWHERE_GUIDE.md
IMPROVEMENT_CHECKLIST.md
implementation_plan.md

# PythonAnywhere deployment (contains hardcoded paths/secrets)
pythonanywhere_wsgi.py
pythonanywhere_task.py

# Utility scripts
login.py

# Agent config
.agents/
.puku/
